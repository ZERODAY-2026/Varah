# Snowflake Connection Credentials
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=DATAMIND_WH
SNOWFLAKE_DATABASE=DATAMIND_DB
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Google Gemma 4 Inference Configuration
# Option A: Google GenAI API (Gemini / Gemma on Google AI Studio)
GEMINI_API_KEY=your_google_ai_studio_api_key

# Option B: Local Ollama (Default for fully offline Gemma 4 execution)
OLLAMA_HOST=http://localhost:11434
GEMMA_MODEL=gemma:4b

